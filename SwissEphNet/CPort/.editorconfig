# SwissEphNet/CPort/ is a line-by-line transliteration of the Swiss Ephemeris C
# source. See ../../CONTRIBUTING.md before changing anything in this folder:
# it must never be reformatted, and that includes analyzer-driven code-style
# fixes, not only whitespace.
#
# Every analyzer diagnostic is silenced here except the small set below that
# has actually caught real bugs in this port (the C.strcmp culture-sensitivity
# bug was found by CA1304/CA1310) or that flags a mis-transliterated `goto`
# (unreachable/unused-code warnings are a real signal in ported C, where a
# `goto` that should have landed on a label sometimes lands past it instead).
#
# dotnet_analyzer_diagnostic.severity is a bulk key that only covers Roslyn
# analyzer diagnostics (CA*/IDE*); it does not touch compiler-native (CS*)
# diagnostics at all, which is why those are listed individually below, both
# the ones silenced (CS1587, CS8981 -- pure noise from this being transliterated
# C, not a real signal) and the ones deliberately left on (CS0162/CS0164/CS0219).
# CS1591 is off for the whole repo via Directory.Build.props, not repeated here.

[*.cs]
# `dotnet_analyzer_diagnostic.severity = none` below silences analyzer DIAGNOSTICS, but
# `dotnet format whitespace` (and `dotnet format style`) reformats code based on FORMATTING
# OPTIONS, which severities do not touch at all -- an unexcluded `dotnet format whitespace`
# run against this repo strips every trailing-whitespace line here (1,335 measured) and
# reflows every K&R `) {` to Allman style (1,065 measured), silently destroying the
# line-by-line correspondence with the C source that this whole file exists to preserve.
# No formatting options are pinned here, deliberately. An earlier attempt pinned three of
# them and every one made an unexcluded `dotnet format whitespace` run WORSE, because
# .editorconfig has no value meaning "leave this alone" -- every value is an assertion the
# formatter will enforce in some direction. Measured against this tree:
#
#                                   no pins          with the pins
#   SwissEphNet/CPort/              12 files         16 files
#   Programs/SweTest/Program.cs     +5/-3            +6/-4  (+509/-1009 with the brace pin)
#   Programs/SweMini/               no change        2 files
#
#   * csharp_new_line_before_open_brace: these files mix Allman and K&R exactly as the C
#     does, so neither `all` nor `none` is safe. `none` reversed the rewrite instead of
#     stopping it and took SweTest/Program.cs from 8 lines touched to 1,518.
#   * insert_final_newline = false: these files all end with a newline already, so the root's
#     `true` was a no-op. `false` is read as "must NOT end with a newline" and emits a
#     deletion for every file.
#   * trim_trailing_whitespace = false: no measurable effect. The trailing whitespace here
#     lives inside the transliterated C block comments, which the formatter treats as opaque,
#     so it was never at risk from this rule in the first place.
#
# CONTRIBUTING.md's three `--exclude` flags remain the only thing that keeps `dotnet format`
# out of these files, and scripts/verify-freeze.ps1 in CI is what catches it when someone
# forgets them. `dotnet_analyzer_diagnostic.severity = none` below is a severity, not a
# formatting option, and does hold.

dotnet_analyzer_diagnostic.severity = none

# Culture-sensitive string/number operations -- these are what surfaced the
# C.strcmp bug (string.Compare without StringComparison, culture-sensitive on
# some platforms/locales). Real transliteration bugs hide behind these.
dotnet_diagnostic.CA1304.severity = warning
dotnet_diagnostic.CA1305.severity = warning
dotnet_diagnostic.CA1307.severity = warning
dotnet_diagnostic.CA1309.severity = warning
dotnet_diagnostic.CA1310.severity = warning

# NaN comparison via == / != instead of double.IsNaN -- always a bug.
dotnet_diagnostic.CA2242.severity = warning

# XML comments transliterated straight from C block comments often land on
# the wrong declaration, and CPort has plenty of type names inherited
# verbatim from lower_snake_case C struct/typedef names -- neither is
# something we can or should fix by touching CPort's text, so silence both.
dotnet_diagnostic.CS1587.severity = none
dotnet_diagnostic.CS8981.severity = none

# Unreachable/unused code -- in a hand-transliterated port, this usually means
# a goto or conditional landed on the wrong label.
dotnet_diagnostic.CS0162.severity = warning
dotnet_diagnostic.CS0164.severity = warning
dotnet_diagnostic.CS0219.severity = warning
