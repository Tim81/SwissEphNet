2.6.0.18:
- Update the code to the Swiss Ephemeris 2.06.00 version.
</PackageReleaseNotes>
    <NeutralLanguage>en</NeutralLanguage>
    <!--
      Deliberately PackageLicenseFile, not PackageLicenseExpression. NuGet only
      accepts OSI/FSF-approved SPDX identifiers in PackageLicenseExpression, and
      the Swiss Ephemeris Professional License arm of this dual license has no
      SPDX identifier, so the dual license cannot be expressed that way. Do not
      "fix" this to PackageLicenseExpression=AGPL-3.0: that would drop
      the Professional option from the package metadata and misrepresent the
      license under which this library is actually offered. See LICENSE and
      NOTICE for the real terms.
    -->
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>TRACE;DEBUG;</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>TRACE;RELEASE;</DefineConstants>
  </PropertyGroup>

  <!--
    The upstream tracking detail that InformationalVersion used to carry.
    AssemblyMetadata takes arbitrary text without having to parse as a version.
  -->
  <ItemGroup>
    <AssemblyMetadata Include="UpstreamSwissEphemerisVersion" Value="2.10.03" />
    <AssemblyMetadata Include="UpstreamSwissEphemerisTag" Value="v2.10.3bfinal" />
  </ItemGroup>

  <!--
    StringExtensions and TypeExtensions are internal (see the remarks on each type):
    these three assemblies call them directly rather than only through the CPort code
    that already sits inside this assembly.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="SwissEphNet.Tests" />
    <InternalsVisibleTo Include="NetStandard20Smoke.Tests" />
    <InternalsVisibleTo Include="SweTest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\agpl-3.0.txt">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\NOTICE">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\README.nuget.md">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>
  
</Project>
