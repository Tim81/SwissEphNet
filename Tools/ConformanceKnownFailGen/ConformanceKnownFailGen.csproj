<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Regenerates Tests/conformance/known-fail.tsv from a live run of the
    correctness oracle. Deliberately a separate project from
    Tests/SwissEphNet.Conformance.Tests (an xunit.v3 self-executing console
    test project cannot also expose a normal custom Main/argument surface),
    the same way Tools/BaselineGen is separate from Tools/BaselineVerify.

    Never invoke this directly - use scripts/regenerate-known-fail.ps1, which
    requires -Reason and appends a provenance log entry, the same shape as
    scripts/regenerate-baseline.ps1.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ConformanceKnownFailGen</RootNamespace>
    <AssemblyName>ConformanceKnownFailGen</AssemblyName>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      The ProjectReference to SwissEphNet.Conformance.Tests below pulls in xunit.v3's
      inproc console runner, which generates its own Main (XunitAutoGeneratedEntryPoint.cs,
      into this project's own obj/ directory) via a source generator triggered
      transitively by that reference. This project already has a real Main (top-level
      statements in Program.cs, the one scripts/regenerate-known-fail.ps1 actually
      invokes), so the generated one is always ignored (CS7022 says so, harmlessly).
      GenerateProgramFile=false (the property that suppresses this in an actual xunit
      test project) does not reach a source generator invoked this indirectly, and no
      other documented per-project opt-out was found; left as a real, investigated,
      harmless warning rather than suppressed with NoWarn/pragma.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Tests\SwissEphNet.Conformance.Tests\SwissEphNet.Conformance.Tests.csproj" />
  </ItemGroup>

</Project>
