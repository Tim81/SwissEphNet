<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>SwissEphNet.Tests</AssemblyName>
    <PackageId>SwissEphNet.Tests</PackageId>
    <IsPackable>false</IsPackable>
    <!-- Properties/AssemblyInfo.cs supplies these three attributes manually. -->
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="files\eop_1962_today.txt" />
    <None Remove="files\eop_finals.txt" />
    <None Remove="files\sefstars.txt" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="files\eop_1962_today.txt" />
    <EmbeddedResource Include="files\eop_finals.txt" />
    <EmbeddedResource Include="files\se00005s.se1" />
    <EmbeddedResource Include="files\seas_18.se1" />
    <EmbeddedResource Include="files\sedeltat.txt" />
    <EmbeddedResource Include="files\sefstars.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SwissEphNet\SwissEphNet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!--
      This project stays on xunit v2 (not the v3 used by Tools/BaselineVerify.Tests),
      so its runner needs the matching v2 major: override the v3 default that
      Directory.Packages.props declares for everyone else.
    -->
    <PackageReference Include="xunit.runner.visualstudio" VersionOverride="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit" />
  </ItemGroup>

</Project>
