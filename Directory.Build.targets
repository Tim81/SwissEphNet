<Project>

  <!--
    Trimming/AOT metadata only makes sense for the modern, non-Windows-Forms TFMs.
    StartsWith covers both "net8.0"/"net10.0" and their "-windows" suffixed variants
    (SweWin). Deliberately placed in Directory.Build.targets, not Directory.Build.props:
    see the note in Directory.Build.props for why a single-TargetFramework project
    would never match this condition if it were evaluated that early.
  -->
  <PropertyGroup Condition="$(TargetFramework.StartsWith('net8.0')) or $(TargetFramework.StartsWith('net10.0'))">
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

</Project>
